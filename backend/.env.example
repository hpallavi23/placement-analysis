# Application Security
SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Local SQLite default: sqlite:///nxtstep.db
# Production PostgreSQL example (e.g. Neon PostgreSQL on Render):
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///nxtstep.db

# CORS Configuration
# Local development origins (localhost:3000, 5173, 5500) are included by default.
# Add comma-separated production origins when hosting the frontend:
# CORS_ORIGINS=https://nxtstep.onrender.com
CORS_ORIGINS=

# Reviewer Role Allowlist (comma-separated emails)
REVIEWER_EMAILS="reviewer.demo@example.com"
